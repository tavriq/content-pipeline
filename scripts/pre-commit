#!/bin/sh
# Pre-commit hook: блокирует коммит материала, нарушающего красные линии.
#
# Живёт в репозитории, в .git/hooks/pre-commit на него ссылка:
#   ln -sf ../../scripts/pre-commit .git/hooks/pre-commit
# На новой машине эту строку надо выполнить один раз — хуки не клонируются.

python3 scripts/lint.py --staged || {
	echo ""
	echo "Коммит остановлен линтером. Поправьте текст или снимите файл из индекса."
	exit 1
}
