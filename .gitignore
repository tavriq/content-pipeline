.env
*.log

# Бот коммитит через git add -A. Ключ деплоя живёт вне рабочего дерева
# (/etc/blog/ssh), это страховка на случай, если его положат в home.
.ssh/

# Тяжёлое вне гита, но сами папки в репозитории есть:
# после клона на VPS скриптам некуда будет писать.
reels/assets/*
!reels/assets/.gitkeep
core/voice/*
!core/voice/.gitkeep
STATUS.md

__pycache__/
*.pyc
.venv/
.DS_Store

# Состояние бота и логи — рабочие файлы, не история проекта
data/bot-state.json
logs/

# Кэш моделей и pip. На сервере home пользователя bot совпадает с корнем
# репозитория, поэтому whisper тянул сюда полтора гигабайта весов, а
# git add -A их подхватывал. Реальное место — /var/lib/blog-cache.
.cache/

# Черновики планов и временные файлы сессий: бот коммитит через git add -A
tmp/
