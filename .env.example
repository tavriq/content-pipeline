# Токен фактчек-бота, выдаёт @BotFather
TELEGRAM_BOT_TOKEN=

# ID канала для публикации, вида @mychannel или -100...
TELEGRAM_CHANNEL_ID=
# author — безопасный тест в личку; channel — реальный канал
TELEGRAM_PUBLISH_TARGET=author

# ID автора в телеграме — кому бот шлёт материалы на проверку.
# Узнаётся у @userinfobot
AUTHOR_CHAT_ID=
# Дополнительные авторы с полным доступом, числовые ID через запятую.
AUTHOR_CHAT_IDS=
# Кому отправлять тестовую публикацию при TELEGRAM_PUBLISH_TARGET=author.
# По умолчанию — основной AUTHOR_CHAT_ID.
PUBLISH_AUTHOR_CHAT_ID=

# ID разработчика, необязательно. Если задан, бот пишет сюда, когда
# изменение не удалось отправить в репозиторий — иначе о сломанной
# синхронизации узнают только когда материалы перестанут приезжать.
DEV_CHAT_ID=

# Timeweb AI Gateway. Ключ создаётся в «ИИ-сервисы → AI Gateway».
# Точные model ID возьми во вкладке «Подключение» или через GET /models.
TIMEWEB_AI_API_KEY=
TIMEWEB_AI_BASE_URL=https://api.timeweb.ai/v1
AI_MODEL_FAST=
AI_MODEL_WRITER=
AI_TIMEOUT_SECONDS=120

# Месячный бюджет AI Gateway. Цены сверяй во вкладке «Подключение» Timeweb.
AI_BUDGET_WARNING_RUB=350
AI_BUDGET_HARD_LIMIT_RUB=500
AI_PRICE_FAST_INPUT_RUB_PER_MILLION=27
AI_PRICE_FAST_OUTPUT_RUB_PER_MILLION=162
AI_PRICE_WRITER_INPUT_RUB_PER_MILLION=270
AI_PRICE_WRITER_OUTPUT_RUB_PER_MILLION=1620

# Отдельная база и пользователь для контентного конвейера.
DATABASE_URL=postgresql://blog_content:change-me@postgres:5432/blog_content
DATABASE_CONNECT_TIMEOUT_SECONDS=10

# NCBI просит указывать контакт для PubMed E-utilities. API key необязателен:
# без него лимит 3 запроса/с, наш сборщик делает только три за запуск.
NCBI_EMAIL=
NCBI_API_KEY=

# Ежедневно в 08:00 МСК бот обновляет источники и темы. Показанные, но не
# выбранные темы через 7 дней архивируются без удаления истории из PostgreSQL.
CONTENT_PIPELINE_HOUR=8
TOPIC_RETENTION_DAYS=7

# На текущем VPS системный пользователь blog имеет uid/gid 109:112.
# Для другого сервера узнай значения командой: id blog
BLOG_UID=109
BLOG_GID=112

# Постоянный кэш Whisper и отдельный read-write deploy key для git push.
BLOG_CACHE_PATH=/var/lib/blog-cache
BLOG_SSH_PATH=/etc/blog/ssh
